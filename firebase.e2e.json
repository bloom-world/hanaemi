{
  "_comment": "e2e 専用（rules-e2e / api-e2e）。開発用の emulator と同時に動かせるよう port をずらしている",
  "firestore": {
    "location": "asia-northeast1",
    "rules": "apps/rules/src/firestore/firestore.rules",
    "indexes": "apps/rules/src/firestore/firestore.indexes.json"
  },
  "storage": {
    "rules": "apps/rules/src/storage/storage.rules"
  },
  "functions": [
    {
      "codebase": "api",
      "source": "dist/apps/api",
      "runtime": "nodejs24",
      "predeploy": ["pnpm exec nx run api:build:production"]
    }
  ],
  "emulators": {
    "functions": {
      "port": 5011
    },
    "firestore": {
      "port": 8181
    },
    "storage": {
      "port": 9198
    },
    "hub": {
      "port": 4460
    },
    "logging": {
      "port": 4560
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
